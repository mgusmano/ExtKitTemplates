Ext.define("<%= it.name %>.view.hmr.Hmr", {
	extend: "Ext.form.Panel",
	xtype: "mainhmr",
	title: "Hmr",
	controller: "form-hmr",
	viewModel: "form-hmr",
	bodyPadding: "10 20 10 20",
	// use this to test sass. $base-color: green;
	items: [
		{
			xtype: "displayfield",
			bind: "(change this text) The count now is: {count}",
			style: {
				fontWeight: "bold",
				fontSize: "24px",
				lineHeight: "32px",
			},
		},
		{
			xtype: "button",
			text: "Increment",
			handler: function (button) {
				const vm = button.lookupViewModel();
				if (vm) {
					const currentCount = vm.get("count") || 0;
					vm.set("count", currentCount + 1);
				} else {
					console.error("No ViewModel found in the component hierarchy!");
				}
			},
		},
	],
});
