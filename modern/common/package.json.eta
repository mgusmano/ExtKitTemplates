{
  "name": "<%= it.projectname %>",
  "version": "1.0.0",
  "description": "ExtKit created package.json",
  "main": "imports.js",
  "scripts": {
    "start": "npm install && npm run dev",
    "dev": "node ./node_modules/@sencha/extkit/ExtKitNpm.cjs",
    "build:testing": "node ./node_modules/@sencha/extkit/ExtKitNpm.cjs",
    "build:production": "node ./node_modules/@sencha/extkit/ExtKitNpm.cjs",
    "demo:testing": "node ./node_modules/@sencha/extkit/ExtKitNpm.cjs",
    "demo:production": "node ./node_modules/@sencha/extkit/ExtKitNpm.cjs",
    "serve:testing": "node ./node_modules/@sencha/extkit/ExtKitNpm.cjs",
    "serve:production": "node ./node_modules/@sencha/extkit/ExtKitNpm.cjs",
    "serve": "serve ./build/production/anextkitproject -p 2080 --cors",
    "servehelp": "serve --help",
    "httpserver": "http-server ./build/production/anextkitproject --silent -p 2080 --gzip --cors -o"

  },
  "keywords": [],
  "author": "Marc Gusmano",
  "license": "ISC",
  "type": "module",
  "dependencies": {

  }
}